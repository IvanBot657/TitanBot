// =========================================

const fs = require("fs");
const path = require("path");

// =========================================
// 📁 ARCHIVO DE DATOS
// =========================================

const DATA_DIR = path.join(__dirname, "..", "data");
const DATA_FILE = path.join(DATA_DIR, "ejercitos.json");

function cargarDatos() {
  if (!fs.existsSync(DATA_DIR)) {
    fs.mkdirSync(DATA_DIR, { recursive: true });
  }

  if (!fs.existsSync(DATA_FILE)) {
    fs.writeFileSync(DATA_FILE, "{}", "utf8");
  }

  try {
    return JSON.parse(
      fs.readFileSync(DATA_FILE, "utf8") || "{}"
    );
  } catch (error) {
    return {};
  }
}

function guardarDatos(data) {
  if (!fs.existsSync(DATA_DIR)) {
    fs.mkdirSync(DATA_DIR, { recursive: true });
  }

  fs.writeFileSync(
    DATA_FILE,
    JSON.stringify(data, null, 2),
    "utf8"
  );
}

// =========================================
// 👤 CREAR EJÉRCITO
// =========================================

function crearEjercito(data, id, nombre) {
  if (!data[id]) {
    data[id] = {
      nombre: nombre || "Comandante",

      nivel: 1,
      xp: 0,

      oro: 1000,

      unidades: {
        soldados: 20,
        arqueros: 5,
        guardianes: 2,
        caballeria: 0
      },

      fortaleza: {
        nivel: 1,
        defensa: 100
      },

      generales: [],

      territorios: 0,

      victorias: 0,
      derrotas: 0,
      racha: 0,

      protegido: false,

      ultimoRecolecta: 0
    };
  }

  if (
    nombre &&
    data[id].nombre === "Comandante"
  ) {
    data[id].nombre = nombre;
  }

  return data[id];
}

// =========================================
// ⚔️ CALCULAR PODER
// =========================================

function calcularPoder(ejercito) {
  const u = ejercito.unidades || {};
  const f = ejercito.fortaleza || {};

  return (
    (u.soldados || 0) * 2 +
    (u.arqueros || 0) * 4 +
    (u.guardianes || 0) * 8 +
    (u.caballeria || 0) * 12 +
    (ejercito.nivel || 1) * 25 +
    (f.nivel || 1) * 20 +
    (ejercito.generales?.length || 0) * 40
  );
}

// =========================================
// 🏷️ OBTENER NÚMERO
// =========================================

function obtenerNumero(id) {
  return String(id || "").replace(
    /[^0-9]/g,
    ""
  );
}

// =========================================
// 📈 XP
// =========================================

function xpNecesaria(nivel) {
  return 500 + (nivel - 1) * 250;
}

function subirNivel(ejercito) {
  let subidas = 0;

  while (
    ejercito.xp >=
    xpNecesaria(ejercito.nivel)
  ) {
    ejercito.xp -=
      xpNecesaria(ejercito.nivel);

    ejercito.nivel++;

    subidas++;
  }

  return subidas;
}

// =========================================
// 🏆 FUNCIÓN PRINCIPAL
// =========================================

async function ejercitoDorado(
  sock,
  chat,
  comando,
  args,
  id,
  msg
) {
  if (!comando) {
    return false;
  }

  comando = String(comando)
    .toLowerCase()
    .replace(/^\./, "");

  const comandosPermitidos = [
    "ejercito",
    "tarjetaejercito",
    "atacar",
    "defender",
    "fortaleza",
    "recolectar",
    "reclutar"
  ];

  if (
    !comandosPermitidos.includes(comando)
  ) {
    return false;
  }

  const data = cargarDatos();

  const nombre =
    msg?.pushName ||
    "Comandante";

  const jugador = crearEjercito(
    data,
    id,
    nombre
  );

  // =========================================
  // 👑 .EJERCITO
  // =========================================

  if (comando === "ejercito") {
    jugador.poder =
      calcularPoder(jugador);

    guardarDatos(data);

    const unidades =
      (jugador.unidades.soldados || 0) +
      (jugador.unidades.arqueros || 0) +
      (jugador.unidades.guardianes || 0) +
      (jugador.unidades.caballeria || 0);

    await sock.sendMessage(chat, {
      text:
`🏆 *EJÉRCITO DORADO*

👑 *Comandante:* ${jugador.nombre}

⭐ Nivel: ${jugador.nivel}
✨ XP: ${jugador.xp}/${xpNecesaria(jugador.nivel)}

⚔️ Poder militar: ${jugador.poder}
💰 Oro: ${jugador.oro}

🪖 Unidades: ${unidades}
👥 Generales: ${jugador.generales.length}

🏰 Fortaleza: Nivel ${jugador.fortaleza.nivel}
🌎 Territorios: ${jugador.territorios}

🏆 Victorias: ${jugador.victorias}
❌ Derrotas: ${jugador.derrotas}
🔥 Racha: ${jugador.racha}

━━━━━━━━━━━━━━━━━━━━
🃏 Usa *.tarjetaejercito*`
    });

    return true;
  }

  // =========================================
  // 🃏 .TARJETA EJÉRCITO
  // =========================================

  if (comando === "tarjetaejercito") {
    jugador.poder =
      calcularPoder(jugador);

    guardarDatos(data);

    await sock.sendMessage(chat, {
      text:
`━━━〔 🏆 EJÉRCITO DORADO 〕━━━╮
┃
┃ 👑 .ejercito
┃ 🃏 .tarjetaejercito
┃ ⚔️ .atacar @usuario
┃ 🛡️ .defender
┃ 🏰 .fortaleza
┃ 💰 .recolectar
┃ 🪖 .reclutar
┃
╰━━━━━━━━━━━━━━━━━━━━╯

👑 *COMANDANTE:* ${jugador.nombre}
⚔️ *PODER:* ${jugador.poder}
💰 *ORO:* ${jugador.oro}
⭐ *NIVEL:* ${jugador.nivel}

🏆 Construye tu ejército.
⚔️ Enfrenta a otros comandantes.
🏰 Mejora tu fortaleza.
💰 Consigue oro y recluta soldados.`
    });

    return true;
  }

  // =========================================
  // 🪖 .RECLUTAR
  // =========================================

  if (comando === "reclutar") {
    let cantidad =
      parseInt(args?.[0]) || 5;

    if (cantidad < 1) {
      cantidad = 1;
    }

    if (cantidad > 50) {
      cantidad = 50;
    }

    const precio = cantidad * 20;

    if (jugador.oro < precio) {
      await sock.sendMessage(chat, {
        text:
`❌ *ORO INSUFICIENTE*

🪖 Soldados: ${cantidad}
💰 Costo: ${precio}
💰 Tu oro: ${jugador.oro}`
      });

      return true;
    }

    jugador.oro -= precio;

    jugador.unidades.soldados +=
      cantidad;

    jugador.poder =
      calcularPoder(jugador);

    guardarDatos(data);

    await sock.sendMessage(chat, {
      text:
`🪖 *¡RECLUTAMIENTO COMPLETADO!*

👑 ${jugador.nombre}

🪖 Soldados reclutados: +${cantidad}

⚔️ Poder militar: ${jugador.poder}

💰 Costo: ${precio}
💰 Oro restante: ${jugador.oro}

🏆 ¡Tu ejército ha crecido!`
    });

    return true;
  }

  // =========================================
  // 💰 .RECOLECTAR
  // =========================================

  if (comando === "recolectar") {
    const ahora = Date.now();

    const espera =
      30 * 60 * 1000;

    if (
      jugador.ultimoRecolecta &&
      ahora - jugador.ultimoRecolecta <
        espera
    ) {
      const restante =
        espera -
        (ahora -
          jugador.ultimoRecolecta);

      const minutos =
        Math.ceil(
          restante / 60000
        );

      await sock.sendMessage(chat, {
        text:
`⏳ *RECOLECCIÓN EN ESPERA*

Ya recolectaste oro recientemente.

🕐 Vuelve en aproximadamente *${minutos} minutos*.`
      });

      return true;
    }

    const cantidad =
      300 +
      Math.floor(
        Math.random() * 301
      );

    jugador.oro += cantidad;

    jugador.ultimoRecolecta =
      ahora;

    jugador.xp += 50;

    const niveles =
      subirNivel(jugador);

    jugador.poder =
      calcularPoder(jugador);

    guardarDatos(data);

    let mensajeNivel = "";

    if (niveles > 0) {
      mensajeNivel =
`\n\n🎉 *¡SUBISTE DE NIVEL!*
⭐ Nuevo nivel: ${jugador.nivel}`;
    }

    await sock.sendMessage(chat, {
      text:
`💰 *RECOLECCIÓN COMPLETADA*

👑 ${jugador.nombre}

💰 Oro obtenido: +${cantidad}
💰 Oro total: ${jugador.oro}

✨ XP obtenida: +50${mensajeNivel}

⏳ Próxima recolección:
30 minutos`
    });

    return true;
  }

  // =========================================
  // 🏰 .FORTALEZA
  // =========================================

  if (comando === "fortaleza") {
    const subcomando =
      String(args?.[0] || "")
        .toLowerCase();

    if (
      subcomando === "mejorar"
    ) {
      const nivel =
        jugador.fortaleza.nivel;

      const costo =
        nivel * 500;

      if (jugador.oro < costo) {
        await sock.sendMessage(chat, {
          text:
`❌ *ORO INSUFICIENTE*

🏰 Mejora:
Nivel ${nivel} → ${nivel + 1}

💰 Costo: ${costo}
💰 Tu oro: ${jugador.oro}`
        });

        return true;
      }

      jugador.oro -= costo;

      jugador.fortaleza.nivel++;

      jugador.fortaleza.defensa +=
        50;

      jugador.poder =
        calcularPoder(jugador);

      guardarDatos(data);

      await sock.sendMessage(chat, {
        text:
`🏰 *¡FORTALEZA MEJORADA!*

👑 ${jugador.nombre}

🏰 Nivel:
${nivel} → ${jugador.fortaleza.nivel}

🛡️ Defensa:
${jugador.fortaleza.defensa}

💰 Oro restante:
${jugador.oro}

⚔️ Poder:
${jugador.poder}`
      });

      return true;
    }

    await sock.sendMessage(chat, {
      text:
`🏰 *FORTALEZA DEL EJÉRCITO*

👑 Comandante: ${jugador.nombre}

🏰 Nivel: ${jugador.fortaleza.nivel}
🛡️ Defensa: ${jugador.fortaleza.defensa}
💰 Oro: ${jugador.oro}

━━━━━━━━━━━━━━━━━━━━

🔧 *MEJORAR FORTALEZA*

.fortaleza mejorar

💰 Próximo costo:
${jugador.fortaleza.nivel * 500} oro`
    });

    return true;
  }

  // =========================================
  // 🛡️ .DEFENDER
  // =========================================

  if (comando === "defender") {
    if (jugador.protegido) {
      await sock.sendMessage(chat, {
        text:
`🛡️ *DEFENSA ACTIVA*

👑 ${jugador.nombre}

Tu ejército ya está protegido.

⏳ La protección sigue activa.`
      });

      return true;
    }

    jugador.protegido = true;

    guardarDatos(data);

    await sock.sendMessage(chat, {
      text:
`🛡️ *DEFENSA ACTIVADA*

👑 ${jugador.nombre}

🏰 Tu fortaleza está protegida.

⚔️ No podrás ser atacado
durante los próximos *10 minutos*.

⏳ Protección activa.`
    });

    setTimeout(() => {
      const datosActuales =
        cargarDatos();

      if (datosActuales[id]) {
        datosActuales[id].protegido =
          false;

        guardarDatos(
          datosActuales
        );
      }
    }, 10 * 60 * 1000);

    return true;
  }

  // =========================================
  // ⚔️ .ATACAR
  // =========================================

  if (comando === "atacar") {
    const menciones =
      msg?.message
        ?.extendedTextMessage
        ?.contextInfo
        ?.mentionedJid || [];

    if (!menciones.length) {
      await sock.sendMessage(chat, {
        text:
`⚔️ *ATAQUE*

Debes mencionar a otro comandante.

Ejemplo:

.atacar @usuario`
      });

      return true;
    }

    const enemigoId =
      menciones[0];

    if (enemigoId === id) {
      await sock.sendMessage(chat, {
        text:
`❌ *ATAQUE INVÁLIDO*

No puedes atacar a tu propio ejército.`
      });

      return true;
    }

    const enemigo =
      crearEjercito(
        data,
        enemigoId,
        "Comandante"
      );

    if (enemigo.protegido) {
      await sock.sendMessage(chat, {
        text:
`🛡️ *ATAQUE BLOQUEADO*

@${obtenerNumero(enemigoId)}
tiene la defensa activa.

⚔️ No puedes atacarlo ahora.`,
        mentions: [enemigoId]
      });

      return true;
    }

    jugador.poder =
      calcularPoder(jugador);

    enemigo.poder =
      calcularPoder(enemigo);

    const poderJugador =
      jugador.poder;

    const poderEnemigo =
      enemigo.poder;

    let victoria;

    if (
      poderJugador >
      poderEnemigo
    ) {
      victoria = true;
    } else if (
      poderJugador <
      poderEnemigo
    ) {
      victoria = false;
    } else {
      victoria =
        Math.random() >= 0.5;
    }

    // =====================================
    // 🏆 VICTORIA
    // =====================================

    if (victoria) {
      jugador.victorias++;
      jugador.racha++;

      enemigo.derrotas++;
      enemigo.racha = 0;

      const recompensa =
        Math.min(
          300,
          Math.max(
            100,
            Math.floor(
              enemigo.oro * 0.15
            )
          )
        );

      enemigo.oro =
        Math.max(
          0,
          enemigo.oro - recompensa
        );

      jugador.oro +=
        recompensa;

      jugador.xp += 150;

      const niveles =
        subirNivel(jugador);

      jugador.poder =
        calcularPoder(jugador);

      enemigo.poder =
        calcularPoder(enemigo);

      guardarDatos(data);

      let subida = "";

      if (niveles > 0) {
        subida =
`\n🎉 ¡Subiste al nivel ${jugador.nivel}!`;
      }

      await sock.sendMessage(chat, {
        text:
`🏆 *¡VICTORIA MILITAR!*

👑 *${jugador.nombre}*
⚔️ Poder: ${poderJugador}

🆚

👑 *${enemigo.nombre}*
⚔️ Poder: ${poderEnemigo}

━━━━━━━━━━━━━━━━━━━━

💰 Recompensa: +${recompensa} oro
✨ XP: +150
🔥 Racha: ${jugador.racha}${subida}`,
        mentions: [enemigoId]
      });

      return true;
    }

    // =====================================
    // 🛡️ DERROTA
    // =====================================

    jugador.derrotas++;
    jugador.racha = 0;

    enemigo.victorias++;
    enemigo.racha++;

    jugador.xp += 50;

    const niveles =
      subirNivel(jugador);

    jugador.poder =
      calcularPoder(jugador);

    enemigo.poder =
      calcularPoder(enemigo);

    guardarDatos(data);

    let subida = "";

    if (niveles > 0) {
      subida =
`\n🎉 ¡Subiste al nivel ${jugador.nivel}!`;
    }

    await sock.sendMessage(chat, {
      text:
`🛡️ *¡ATAQUE RECHAZADO!*

👑 *${jugador.nombre}*
⚔️ Poder: ${poderJugador}

🆚

👑 *${enemigo.nombre}*
⚔️ Poder: ${poderEnemigo}

━━━━━━━━━━━━━━━━━━━━

❌ Tu ataque fue rechazado.

✨ XP obtenida: +50${subida}`,
      mentions: [enemigoId]
    });

    return true;
  }

  return false;
}

// =========================================
// 📦 EXPORTAR
// =========================================

module.exports = ejercitoDorado;
